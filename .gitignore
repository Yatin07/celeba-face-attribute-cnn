# ==============================================================================
# Model Outputs and Checkpoints (except those committed)
# ==============================================================================
# We want to KEEP the important final models, so we do NOT globally ignore *.pth
# But we DO want to ignore heavy non-essential data.
*.npy
!stage3_gpu_single/outputs/*.npy

# Ignore all extra output text logs and old comparison logs at root
model_comparison_output.txt

# ==============================================================================
# Heavy Dataset Files (CRITICAL!)
# ==============================================================================
# Never commit the image dataset or raw archives
img_align_celeba/
*.7z
*.zip
*.tar
*.gz
*.whl

# Ignore original drive download folder if it exists
drive-download*/

# Ignore old backup project directories
CelebA_Project/

